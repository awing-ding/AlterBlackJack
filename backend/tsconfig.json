{
  "include": ["*.ts", "database/**/*.ts", "routes/**/*.ts"],
  "compilerOptions": {
    "baseUrl": "./",
    "target": "ES2020",
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./*"],
      "@database/*": ["./database/*"],
      "@routes/*": ["./routes/*"]
    },
    "allowSyntheticDefaultImports": true
  }
}
